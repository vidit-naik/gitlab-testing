# Copy to checksum/.env (git-ignored) and fill in the values.
# Once the real values exist, sync them to the cloud with:
#   chk upload-env -n gitlab-testing
# (requires the app to be registered in Checksum and CHECKSUM_SUPPORT_TOKEN in
# the checksum-customer-engineering workspace .env)

# Checksum project API key — https://app.checksum.ai/#/settings/
CHECKSUM_API_KEY=<your-checksum-api-key>

# Application under test
BASE_URL=https://crm-demo-agents.vercel.app/

# Optional. The demo CRM accepts any email/password (client-side only); these
# override the defaults in checksum.config.ts.
# CRM_USER_EMAIL=checksum@example.com
# CRM_USER_PASSWORD=password
